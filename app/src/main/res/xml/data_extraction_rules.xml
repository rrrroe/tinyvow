<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="datastore/" />
        <exclude
            domain="file"
            path="share/" />
        <exclude
            domain="file"
            path="reward_icons/" />
