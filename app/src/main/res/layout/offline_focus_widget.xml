<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/offline_focus_widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/offline_focus_widget_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/offline_focus_widget_icon_background"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_offline_focus_widget" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/offline_focus_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/offline_focus_title"
                android:textColor="@color/widget_focus_text"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/offline_focus_widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/offline_focus_widget_subtitle"
                    android:textColor="@color/widget_focus_text_muted"
                    android:textSize="10sp" />

                <Chronometer
                    android:id="@+id/offline_focus_widget_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_focus_text_muted"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/offline_focus_widget_action"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/offline_focus_widget_action_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/offline_focus_start_short"
            android:textColor="@color/widget_focus_on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
